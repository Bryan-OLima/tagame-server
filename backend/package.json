{
  "name": "tagame-api",
  "version": "0.1.0",
  "private": true,
  "description": "TAGAME local-first API",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run migrate:deploy && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prisma": "^6.19.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
